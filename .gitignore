cat > .gitignore << 'EOF'
### Sensitive Configuration ###
# Allow profile-based configuration files in version control
# as they use environment variables for sensitive data
!src/main/resources/application.properties
!src/main/resources/application-h2.properties
!src/main/resources/application-mysql.properties
!src/main/resources/application.properties.template
!src/main/resources/application-*.properties.template
src/main/resources/application-*.properties
.env
.env.local
secrets.properties

### Maven ###
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
.mvn/timing.properties

### IntelliJ IDEA ###
.idea/modules.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/libraries/
.idea/
*.iws
*.iml
*.ipr
out/

### Eclipse ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

### VS Code ###
.vscode/
*.code-workspace

### Operating System Files ###

# Mac OS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

### Logs ###
*.log
logs/
log/

### Database ###
*.db
*.sqlite
*.sqlite3
*.h2.db

### Compiled Files ###
*.class
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar

### Security ###
*.pem
*.key
*.p12
*.jks

### Miscellaneous ###
*.bak
*.tmp
*.temp
*.swp
HELP.md
EOF